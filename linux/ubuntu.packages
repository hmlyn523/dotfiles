# Ubuntu/Debian package list for dotfiles setup
# Installed via: sudo apt-get install -y <packages>
#
# Tools NOT available here (installed separately in dotfiles script):
#   - mise      → curl https://mise.run | sh
#   - starship  → curl -sS https://starship.rs/install.sh | sh
#   - eza       → cargo install eza  OR  check latest releases
#   - yazi      → cargo install yazi-fm  OR  check latest releases
#   - zoxide    → curl -sS https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh
#   - git-delta → download binary from https://github.com/dandavison/delta/releases
#   - gh        → follow https://cli.github.com/manual/installation

# Core system tools
curl
wget
git
stow
tmux
tree
watch
w3m

# Modern CLI replacements
fzf
htop
jq

# Development tools
cmake
ninja-build
gcc
make
pkg-config
libsqlite3-dev
postgresql

# Editor
neovim

# File tools
p7zip-full

# Language tools
python3
python3-pip
pipx
ruby

# Shell & completions
zsh
zsh-autosuggestions

# Tealdeer (tldr)
tealdeer
