# Fedora package list for dotfiles setup
# Installed via: sudo dnf install -y <packages>
#
# Tools NOT available here (installed separately in dotfiles script):
#   - mise      → curl https://mise.run | sh
#   - starship  → curl -sS https://starship.rs/install.sh | sh

# Core system tools
curl
wget
git
stow
tmux
tree
watch
w3m

# Modern CLI replacements
eza
fzf
zoxide
htop
jq

# Development tools
cmake
ninja-build
gcc
make
pkg-config
sqlite
postgresql

# Editor
neovim

# File tools
p7zip

# Language tools
python3
python3-pip
pipx
ruby

# Shell & completions
zsh
zsh-autosuggestions

# GitHub CLI
gh

# Git extras
git-delta
tealdeer

# File manager
yazi
