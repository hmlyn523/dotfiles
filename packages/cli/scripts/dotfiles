#!/bin/sh

set -e

###########################################################
# Color Definitions (ANSI)
###########################################################
BOLD='\033[1m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
PURPLE='\033[0;35m'
NC='\033[0m'

###########################################################
# Utils / Visual Enhancements
###########################################################
log_title() {
    printf "\n${BOLD}${PURPLE}==========================================================${NC}\n"
    printf "${BOLD}${PURPLE}  🚀 $1${NC}\n"
    printf "${BOLD}${PURPLE}==========================================================${NC}\n"
}

log_info()    { printf "${CYAN}  ❯${NC} %s\n" "$1"; }
log_success() { printf "${GREEN}  ✔${NC} ${BOLD}%s${NC}\n" "$1"; }
log_warning() { printf "${YELLOW}  ⚠${NC} %s\n" "$1"; }
log_error()   { printf "${RED}  ✖${NC} ${BOLD}%s${NC}\n" "$1"; }

show_header() {
    local CYAN='\033[0;36m'
    local MAGENTA='\033[0;35m'
    local BOLD='\033[1m'
    local NC='\033[0m'
    printf "\n"
    printf "${MAGENTA}${BOLD}   ◆ Dotfiles${NC} :: ${CYAN}${BOLD}Setup Wizard${NC}\n"
    printf "   ──────────────────────────────────────────\n"
    printf "   👤 User   : ${BOLD}html523${NC}\n"
    printf "   🔧 Status : ${CYAN}Initializing...${NC}\n"
    printf "\n"
}

show_spinner() {
    pid=$1
    spinstr='|/-\'
    while kill -0 $pid 2>/dev/null; do
        temp=${spinstr#?}
        printf "\r${CYAN}  ❯${NC} Updating packages... [%c] " "$spinstr"
        spinstr=$temp${spinstr%"$temp"}
        sleep 0.1
    done
    printf "\r\033[K\n"
}

###########################################################
# Initialization
###########################################################
GITHUB_PATH=~/projects/github.com
GIT_CLONE_PATH="$GITHUB_PATH"
STOW_PACKAGES_PATH="$GIT_CLONE_PATH/dotfiles/packages"

os_type="$(uname)"
arch_name="$(uname -m)"

###########################################################
# OS / Distro Detection
###########################################################
detect_distro() {
    if [ "$os_type" = "Darwin" ]; then
        DISTRO="macos"
    elif [ "$os_type" = "Linux" ]; then
        if [ -f /etc/os-release ]; then
            DISTRO=$(. /etc/os-release && printf "%s" "${ID:-linux-unknown}" | tr '[:upper:]' '[:lower:]')
        elif [ -f /etc/arch-release ]; then
            DISTRO="arch"
        else
            DISTRO="linux-unknown"
        fi
    else
        DISTRO="unknown"
    fi
}

detect_distro

###########################################################
# Bootstrap: Ensure git and zsh are installed
###########################################################
# git または zsh がない場合に実行
if ! command -v git >/dev/null 2>&1 || ! command -v zsh >/dev/null 2>&1; then
    printf "  ❯ Prerequisites (git/zsh) not found. Bootstrapping...\n"
    case "$DISTRO" in
        fedora)
            sudo dnf install -y git zsh
            ;;
        arch)
            sudo pacman -S --needed --noconfirm git zsh
            ;;
        ubuntu|debian)
            sudo apt-get update -y && sudo apt-get install -y git zsh
            ;;
    esac
fi

###########################################################
# Bootstrap: Ensure git is installed
###########################################################
if ! command -v git >/dev/null 2>&1; then
    printf "  ❯ git not found. Bootstrapping...\n"
    case "$DISTRO" in
        macos)
            # macOSの場合はHomebrewのインストールプロセスでgitが入るため、
            # ここでは何もしなくても後のsetup_homebrewで解決されます
            ;;
        fedora)
            sudo dnf install -y git
            ;;
        arch)
            sudo pacman -S --needed --noconfirm git
            ;;
        ubuntu|debian)
            sudo apt-get update -y && sudo apt-get install -y git
            ;;
    esac
fi

show_header
log_info "OS: ${os_type} / Arch: ${arch_name} / Distro: ${DISTRO}"

# Options parsing
unlink_packages=
verbose=
skip_apps=
skip_git=
skip_prune=
for i in "$@"; do
    case "$i" in
        -s|--skip-apps)         skip_apps=1; shift ;;
        -v|--verbose)           verbose=1; shift ;;
        -g|--skip-git-setting)  skip_git=1; shift ;;
        -p|--skip-mise-prune)   skip_prune=1; shift ;;
        -u=*|--unlink=*)        unlink_packages="${i#*=}"; shift ;;
        *) ;;
    esac
done

is_file() { [ -f "$1" ]; }
is_dir()  { [ -d "$1" ]; }
ensure_dir() { if ! is_dir "$1"; then mkdir -p "$1"; fi; }

###########################################################
# 自作 Stow 関数 (依存なしでリンクとアンリンクを実現)
###########################################################

# シンボリックリンクを展開する関数
_link_package() {
    local src_dir="$1"
    local dest_root="$2"
    local ignore_pattern="$3"

    [ ! -d "$src_dir" ] && return 1

    # ディレクトリの中身をループ
    for entry in "$src_dir"/* "$src_dir"/.[!.]*; do
        [ -e "$entry" ] || continue # ファイルが存在しない場合はスキップ

        local name=$(basename "$entry")
        
        # 除外設定
        [[ "$name" == ".DS_Store" ]] && continue
        if [ -n "$ignore_pattern" ] && printf "%s\n" "$name" | grep -qE "$ignore_pattern"; then
            continue
        fi

        local dest="${dest_root}/${name}"

        if [ -d "$entry" ] && [ -d "$dest" ] && [ ! -L "$dest" ]; then
            # 【重要】両方にディレクトリがある場合は、さらに深く潜ってリンクを貼る
            _link_package "$entry" "$dest" "$ignore_pattern"
        else
            # ファイル、またはターゲット側にディレクトリがない場合はリンクを貼る
            local abs_src="$(cd "$(dirname "$entry")" && pwd)/$name"
            
            if [ -L "$dest" ]; then
                ln -sf "$abs_src" "$dest"
                printf "   Relinked: %s\n" "$name"
            elif [ -e "$dest" ]; then
                printf "⚠️  Skipped: $dest (Already exists as a real file/dir)\n"
            else
                ln -s "$abs_src" "$dest"
                printf "   Linked: %s\n" "$name"
            fi
        fi
    done
}

# シンボリックリンクを解除(削除)する関数
_unlink_package() {
    local src_dir="$1"
    local dest_root="$2"

    [ ! -d "$src_dir" ] && return 1

    find "$src_dir" -type f | while read -r src; do
        local rel_path="${src#$src_dir/}"
        local dest="${dest_root}/${rel_path}"

        if [ -L "$dest" ]; then
            rm "$dest"
            printf "   Unlinked: %s\n" "$rel_path"
        fi
    done
}

###########################################################
# Stow unlink (置き換え)
###########################################################
if [ -n "$unlink_packages" ]; then
    log_title "Unlinking dotfiles"
    # 元: stow -vD -d "$STOW_PACKAGES_PATH" -t ~ "$unlink_packages"
    _unlink_package "$STOW_PACKAGES_PATH/$unlink_packages" "$HOME"
    log_success "Unlink complete."
    exit
fi

###########################################################
# Check OS Compatibility
###########################################################
log_title "System Compatibility Check"
case "$DISTRO" in
    macos|fedora|arch|ubuntu|debian)
        log_success "Supported distro: ${DISTRO}"
        ;;
    *)
        log_error "Unsupported OS/distro: ${DISTRO}"
        log_error "Supported: macOS, Fedora, Arch Linux, Ubuntu/Debian"
        exit 1
        ;;
esac

###########################################################
# Homebrew (macOS only)
###########################################################
setup_homebrew() {
    log_title "Homebrew Setup"
    if ! command -v brew >/dev/null 2>&1; then
        log_info "Installing Homebrew..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        if [ "${arch_name}" = "arm64" ] && [ -f /opt/homebrew/bin/brew ]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        elif [ -f /usr/local/bin/brew ]; then
            eval "$(/usr/local/bin/brew shellenv)"
        fi
        log_success "Homebrew installed."
    else
        log_info "Homebrew already present."
    fi
}

###########################################################
# Linux: Extra tools not in standard repos
###########################################################
install_linux_extra_tools() {
    # mise (runtime manager) - not in standard Linux repos
    if ! command -v mise >/dev/null 2>&1; then
        log_info "Installing mise via official installer..."
        curl https://mise.run | sh
        export PATH="$HOME/.local/bin:$PATH"
        log_success "mise installed."
    else
        log_info "mise already present."
    fi

    # starship (prompt) - not in standard Linux repos
    if ! command -v starship >/dev/null 2>&1; then
        log_info "Installing starship via official installer..."
        curl -sS https://starship.rs/install.sh | sh -s -- --yes
        log_success "starship installed."
    else
        log_info "starship already present."
    fi
}

###########################################################
# Linux: Native package installation
###########################################################
install_linux_packages() {
    local pkg_file="$GITHUB_PATH/dotfiles/linux/${DISTRO}.packages"
    if [ ! -f "$pkg_file" ]; then
        log_warning "Package list not found: $pkg_file"
        log_warning "Skipping native package installation."
        install_linux_extra_tools
        return
    fi

    # Strip comments and blank lines
    packages=$(grep -v '^#' "$pkg_file" | grep -v '^[[:space:]]*$' | tr '\n' ' ')

    case "$DISTRO" in
        fedora)
            log_info "Installing packages via dnf..."
            # --skip-unavailable を追加して、リポジトリにないパッケージで止まらないようにする
            sudo dnf install -y --skip-unavailable $packages
            ;;
        arch)
            log_info "Installing packages via pacman..."
            # shellcheck disable=SC2086
            sudo pacman -S --needed --noconfirm $packages
            ;;
        ubuntu|debian)
            log_info "Installing packages via apt..."
            sudo apt-get update -y
            # shellcheck disable=SC2086
            sudo apt-get install -y $packages
            ;;
    esac

    install_linux_extra_tools
}

###########################################################
# Clone dotfiles
###########################################################
log_title "Dotfiles Repository"
ensure_dir "$GIT_CLONE_PATH"

if ! is_dir "$GIT_CLONE_PATH/dotfiles"; then
    log_info "Cloning from GitHub..."
    cd "$GITHUB_PATH"
    git clone https://github.com/hmlyn523/dotfiles.git
    log_success "Cloning complete."
else
    log_info "Repository already exists at $GIT_CLONE_PATH/dotfiles"
fi

###########################################################
# Install Apps and CLIs
###########################################################
if [ ! "$skip_apps" ]; then
    log_title "Package Installation"

    if [ "$DISTRO" = "macos" ]; then
        setup_homebrew
        if command -v brew >/dev/null 2>&1 && is_file "$GITHUB_PATH/dotfiles/Brewfile"; then
            before_list=$( (brew list --formula 2>/dev/null; brew list --cask 2>/dev/null) | sort)

            if [ -n "$verbose" ]; then
                log_info "Updating packages (Verbose mode)..."
                brew bundle --file "$GITHUB_PATH/dotfiles/Brewfile" --cleanup -v
            else
                brew bundle --file "$GITHUB_PATH/dotfiles/Brewfile" --cleanup > /tmp/dotfiles_brew.log 2>&1 &
                brew_pid=$!
                show_spinner $brew_pid
                wait $brew_pid
                brew_status=$?
                if [ $brew_status -ne 0 ]; then
                    log_error "Brew bundle failed! Outputting log:"
                    cat /tmp/dotfiles_brew.log
                    exit 1
                fi
            fi

            after_list=$( (brew list --formula 2>/dev/null; brew list --cask 2>/dev/null) | sort)
            printf "$before_list\n" > /tmp/dotfiles_before_list.txt
            printf "$after_list\n"  > /tmp/dotfiles_after_list.txt
            installed=$(comm -23 /tmp/dotfiles_after_list.txt /tmp/dotfiles_before_list.txt)
            uninstalled=$(comm -13 /tmp/dotfiles_after_list.txt /tmp/dotfiles_before_list.txt)
            rm /tmp/dotfiles_before_list.txt /tmp/dotfiles_after_list.txt

            log_file="$HOME/.dotfiles_brew_history.log"
            timestamp=$(date '+%Y-%m-%d %H:%M:%S')

            if [ -z "$installed" ] && [ -z "$uninstalled" ]; then
                log_success "All packages are up to date."
            fi
            if [ -n "$installed" ]; then
                printf "[$timestamp] INSTALLED: $installed\n" >> "$log_file"
                log_success "Installed: $(printf "%s" "$installed" | tr '\n' ' ')"
            fi
            if [ -n "$uninstalled" ]; then
                printf "[$timestamp] UNINSTALLED: $uninstalled\n" >> "$log_file"
                log_warning "Removed: $(printf "%s" "$uninstalled" | tr '\n' ' ')"
            fi
        fi
    else
        install_linux_packages
    fi
fi

###########################################################
# Stow link (置き換え)
###########################################################
log_title "Symbolic Linking (Custom Stow)"
ensure_dir ~/.config/alacritty
ensure_dir ~/.config/starship
ensure_dir ~/.config/yarn/global
mkdir -p "$HOME/scripts"

# Packages that only apply to macOS
MACOS_ONLY_PACKAGES="keybindings"

for pkg_path in "$STOW_PACKAGES_PATH"/*; do
    if [ -d "$pkg_path" ]; then
        pkg_name=$(basename "$pkg_path")

        if [ "$DISTRO" != "macos" ]; then
            skip=0
            for macos_pkg in $MACOS_ONLY_PACKAGES; do
                if [ "$pkg_name" = "$macos_pkg" ]; then
                    log_info "Skipping $pkg_name (macOS only)"
                    skip=1
                    break
                fi
            done
            [ "$skip" = "1" ] && continue

            log_info "Linking $pkg_name..."
            # 元: stow -vd "$STOW_PACKAGES_PATH" -t ~ --ignore='^Library$' "$pkg_name"
            # 代替: 第三引数に正規表現の除外パターンを渡す
            _link_package "$pkg_path" "$HOME" "^Library/"
        else
            log_info "Linking $pkg_name..."
            # 元: stow -vd "$STOW_PACKAGES_PATH" -t ~ "$pkg_name"
            _link_package "$pkg_path" "$HOME"
        fi
    fi
done
log_success "All links created."

###########################################################
# Configure macOS (macOS only)
###########################################################
if [ "$DISTRO" = "macos" ]; then
    log_title "macOS Defaults"
    if is_file ~/scripts/macos-defaults; then
        ~/scripts/macos-defaults
        log_success "macOS settings applied."
    else
        log_warning "macos-defaults script not found."
    fi
fi

###########################################################
# Setup Neovim
###########################################################
log_title "Neovim Setup"
plug_path=~/.local/share/nvim/site/autoload/plug.vim
if ! is_file "$plug_path"; then
    log_info "Installing vim-plug..."
    sh -c "curl -fLo $plug_path --create-dirs https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim"
fi

plugged_path=~/.local/share/nvim/autoload/plugged
if ! is_dir "$plugged_path"; then
    log_info "Running PlugInstall..."
    nvim +PlugInstall +qall
    log_success "Neovim plugins installed."
fi

###########################################################
# Git Setup
###########################################################
if [ ! "$skip_git" ]; then
    log_title "Git & Security Setup"
    current_signing_key=$(git config --global --get user.signingkey 2>/dev/null || true)
    if [ -n "$current_signing_key" ] && is_file ~/.ssh/id_rsa.pub; then
        log_info "Signing key and SSH already set."
    else
        log_success "Git security configuration updated."
    fi
fi

###########################################################
# Finalizing with mise
###########################################################
log_title "mise (Runtime Management)"
# Ensure ~/.local/bin is in PATH (curl-installed mise on Linux)
export PATH="$HOME/.local/bin:$PATH"
if command -v mise >/dev/null 2>&1; then
    mise install
    log_success "Runtime versions installed."
else
    log_warning "mise not installed. Skipping runtime setup."
fi

###########################################################
# Rust Toolchain Setup
###########################################################
log_title "Rust Toolchain"
if command -v rustup >/dev/null 2>&1; then
    log_info "Ensuring rustfmt is installed..."
    rustup component add rustfmt
    log_success "rustfmt is ready."
else
    log_warning "rustup not found. Skipping rustfmt installation."
fi

###########################################################
# Switch Default Shell to zsh
###########################################################
# 現在のシェルが zsh でない場合に実行
if [ "$(basename "$SHELL")" != "zsh" ]; then
    log_title "Finalizing Shell Setup"
    log_info "Changing default shell to zsh..."
    
    ZSH_PATH=$(command -v zsh)

    if [ -n "$ZSH_PATH" ]; then
        # /etc/shells に登録されていない場合は追記する (Fedora対策)
        if ! grep -q "$ZSH_PATH" /etc/shells; then
            log_info "Registering $ZSH_PATH to /etc/shells..."
            printf "%s\n" "$ZSH_PATH" | sudo tee -a /etc/shells > /dev/null
        fi

        # chshを実行
        if sudo chsh -s "$ZSH_PATH" "$USER"; then
            log_success "Default shell changed to $ZSH_PATH"
            log_warning "Please restart your terminal or re-login to apply the changes."
        else
            log_error "Failed to change shell. Try manual: sudo chsh -s $ZSH_PATH $USER"
        fi
    else
        log_error "zsh not found. Could not change default shell."
    fi
fi

printf "\n${BOLD}${GREEN}✨ ALL DONE! Enjoy your new environment! ✨${NC}\n\n"

